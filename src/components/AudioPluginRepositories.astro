---
import audioPluginRepositories from "../data/audioPluginRepositories.json";
---

<h3>Audio Plugin Repositories</h3>
<span class="blank-line"></span>
<ul>
    {
        audioPluginRepositories.map((repository) => (
            <li>
                <span class="line">
                    <span class="line-content">
                        <a href={repository.url} aria-label={`${repository.name} repository on GitHub`}>{repository.name}</a>
                    </span>
                </span>
            </li>
        ))
    }
</ul>
